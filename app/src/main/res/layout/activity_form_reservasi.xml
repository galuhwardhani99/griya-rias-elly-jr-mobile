<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarReservasi"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brown_dark"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Form Reservasi Rias"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nama Paket -->
            <TextView
                android:id="@+id/tvNamaPaketReservasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paket: -"
                android:textColor="@color/brown_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Sesi Waktu Acara -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sesi Waktu Acara"
                android:textColor="@color/brown_dark"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSesiWaktu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/btn_dropdown" />

            <!-- Nama Client -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nama Lengkap"
                android:textColor="@color/brown_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNamaClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Masukkan nama pemesan"
                android:inputType="textPersonName" />

            <!-- Nomor HP / WA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nomor HP / WhatsApp"
                android:textColor="@color/brown_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNomorHp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Contoh: 08123456789"
                android:inputType="phone" />

            <!-- Tanggal Acara -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tanggal Acara"
                android:textColor="@color/brown_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTanggalAcara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:focusable="false"
                android:hint="Pilih Tanggal Acara (YYYY-MM-DD)"
                android:inputType="none" />

            <!-- Jam Mulai Rias (Dapat disembunyikan/ditampilkan dinamis) -->
            <TextView
                android:id="@+id/tvLabelJamMulai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Jam Mulai Rias"
                android:textColor="@color/brown_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etJamMulai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:focusable="false"
                android:hint="Pilih Jam Mulai Rias (HH:mm)"
                android:inputType="none" />

            <!-- Lokasi Acara -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Lokasi Acara / Alamat Lengkap"
                android:textColor="@color/brown_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLokasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Masukkan alamat lokasi acara"
                android:inputType="textMultiLine" />

            <!-- Catatan Tambahan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Catatan Tambahan (Opsional)"
                android:textColor="@color/brown_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Catatan atau permintaan khusus"
                android:inputType="textMultiLine" />

            <ProgressBar
                android:id="@+id/pbReservasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnKirimReservasi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/gold"
                android:text="Kirim Reservasi"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>