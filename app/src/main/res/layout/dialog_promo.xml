<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/ivPromoImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="Gambar Promo" />

    <TextView
        android:id="@+id/tvPromoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvPromoBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnKlaim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Klaim Promo Sekarang"
        android:layout_marginTop="16dp"
        android:backgroundTint="#8D6E63"
        android:textColor="#FFFFFF" />

</LinearLayout>