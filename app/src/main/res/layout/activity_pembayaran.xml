<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pembayaran Reservasi"
            android:textColor="#4E342E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="1. Screenshot Kode QRIS DANA di bawah ini.\n2. Bayar melalui e-wallet / m-Banking kamu.\n3. Unggah foto bukti transfer di bawah."
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- GAMBAR QR CODE DANA -->
        <ImageView
            android:id="@+id/imgQrisDana"
            android:layout_width="200dp"
            android:layout_height="240dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/qris_dana" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Pembayaran"
            android:textColor="#4E342E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- PREVIEW FOTO BUKTI TRANSFER -->
        <ImageView
            android:id="@+id/imgBuktiPreview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="10dp"
            android:background="#F5F5F5"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- TOMBOL PILIH FOTO DARI GALERI -->
        <Button
            android:id="@+id/btnPilihBukti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#8D6E63"
            android:text="Pilih Foto Bukti Transfer (Galeri)"
            android:textColor="#FFFFFF" />

        <!-- TOMBOL AMBIL FOTO VIA KAMERA -->
        <Button
            android:id="@+id/btnKameraBukti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7A5244"
            android:text="Scan / Ambil Foto via Kamera"
            android:textColor="#FFFFFF" />

        <!-- TOMBOL KIRIM BUKTI -->
        <Button
            android:id="@+id/btnKirimBukti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4E342E"
            android:enabled="false"
            android:text="Kirim Bukti Pembayaran"
            android:textColor="#FFFFFF" />

        <ProgressBar
            android:id="@+id/progressBarPembayaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>