<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="wardhani.galuh.project_griyarias">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project_griyarias"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- FCM Meta-Data -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="griya_promo_v2" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@android:drawable/ic_dialog_info" />

        <!-- Service FCM -->
        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Auth Activities -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".auth.RegisterActivity" android:exported="false" />

        <!-- Admin Activity -->
        <activity android:name=".admin.AdminDashboardActivity" android:exported="false" />

        <!-- Client Activities -->
        <activity android:name=".client.ClientDashboardActivity" android:exported="false" />
        <activity android:name=".client.DetailPromoActivity" android:exported="false" />
        <activity android:name=".client.InfoAplikasiActivity" android:exported="false" />
        <activity android:name=".client.KatalogPaketActivity" android:exported="false" />
        <activity android:name=".client.LihatJadwalActivity" android:exported="false" />

    </application>

</manifest>