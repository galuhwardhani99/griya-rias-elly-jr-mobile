# =========================================================================
# Android Studio / IntelliJ IDEA / Gradle (.gitignore)
# =========================================================================

# 1. Android Studio & IDE Configuration (Menghindari konflik antar developer)
.idea/
*.iml
*.iws
*.ipr
.navigation/

# 2. Gradle & Build Outputs
.gradle/
build/
/build
app/build/

# 3. Local Configuration Files (Sensitif & Spesifik per Komputer)
local.properties
.gradle/config.properties

# 4. Keystore / Signing Keys (SANGAT SENSITIF - Jangan sampai ter-push ke Git)
*.jks
*.keystore
*.pepk

# 5. Native / C++ Build Artifacts (Jika menggunakan NDK/C++)
.externalNativeBuild/
.cxx/

# 6. Profiling & Testing Artifacts
/captures
.gradle/buildOutputCleanup/
/app/build/outputs/apk/
/app/build/outputs/bundle/

# 7. File Sistem Operasi (Windows & macOS)
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 8. Miscellaneous / Log Files
*.log
.bin/